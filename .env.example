GENEAGENT_APP_ENV=dev
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
GENEAGENT_DEV_HOST_PLATFORM=windows
GENEAGENT_DEV_SHELL=powershell
GENEAGENT_DEV_WORKSPACE_ROOT=D:\geneagent
GENEAGENT_MODEL_PROVIDER=openai
GENEAGENT_MODEL_NAME=gpt-5.4
GENEAGENT_SCHEDULER_TYPE=slurm
GENEAGENT_CONDA_ENV_NAME=geneagent-base
GENEAGENT_WORK_ROOT=D:\geneagent\work
GENEAGENT_LOG_ROOT=D:\geneagent\logs
GENEAGENT_KNOWLEDGE_BASE_ROOT=D:\geneagent\knowledge
GENEAGENT_KNOWLEDGE_EXTERNAL_FALLBACK_ENABLED=true
GENEAGENT_KNOWLEDGE_EXTERNAL_FALLBACK_POLICY=tiered
GENEAGENT_KNOWLEDGE_EXTERNAL_FALLBACK_DEFAULT_SENSITIVITY=low
GENEAGENT_KNOWLEDGE_EXTERNAL_FALLBACK_DOMAIN_SENSITIVITY_LIMITS={"bioinformatics":"low","knowledge":"medium","system":"low"}
GENEAGENT_MAX_CPU=64
GENEAGENT_MAX_MEM_GB=256
GENEAGENT_DRY_RUN_DEFAULT=true
GENEAGENT_SCHEDULER_REAL_EXECUTION_ENABLED=false
GENEAGENT_SCHEDULER_RETRY_MAX_ATTEMPTS=3
GENEAGENT_SCHEDULER_RETRY_BACKOFF_SECONDS=[2,5,10]
GENEAGENT_SCHEDULER_COMMAND_TIMEOUT_SECONDS=60
GENEAGENT_SCHEDULER_QUOTA_CPU_HOURS_LIMIT=1024
GENEAGENT_SCHEDULER_QUOTA_MEMORY_GB_LIMIT=512
GENEAGENT_SCHEDULER_QUOTA_MAX_CONCURRENT_JOBS=64
GENEAGENT_SCHEDULER_CURRENT_ACTIVE_JOBS=0
GENEAGENT_OUTBOUND_POLICY_ENFORCED=true

# Trusted remote execution: PC control plane, remote Linux execution plane.
# Do not store passwords, private keys, or real private addresses here.
# Safe default: preview only. Set ssh_shell_trusted or ssh_slurm_trusted plus
# GENEAGENT_SCHEDULER_REAL_EXECUTION_ENABLED=true only after remote-check passes.
# The fixed `remote-smoke` command and guarded `remote-session-smoke` validation
# flow also require real execution enabled.
GENEAGENT_EXECUTION_MODE=local_preview
GENEAGENT_REMOTE_PROFILE_NAME=default
GENEAGENT_HPC_HOST=gene-server.example.internal
GENEAGENT_HPC_USER=your_server_username
GENEAGENT_HPC_PORT=22
GENEAGENT_HPC_WORK_ROOT=/data2/your_username/geneagent_runs
# Ordinary-server write boundary. Keep this at your user directory prefix;
# GeneAgent will reject ssh_shell_trusted work roots outside this allowlist.
GENEAGENT_REMOTE_ALLOWED_WRITE_ROOTS=["/data2/your_username"]
# Ordinary-server safety caps. Unlike SLURM, a normal server has no queue-side
# resource isolation, so GeneAgent blocks submits above these caps and writes
# thread/ulimit guards into run.sh.
GENEAGENT_REMOTE_SHELL_CPU_CAP=32
GENEAGENT_REMOTE_SHELL_MEMORY_GB_CAP=256
GENEAGENT_REMOTE_SHELL_WALLTIME_CAP=24:00:00
GENEAGENT_REMOTE_SHELL_MAX_CONCURRENT_RUNS=2
GENEAGENT_REMOTE_SHELL_PROCESS_LIMITS_ENABLED=true
# Used only by SLURM/SBASE modes; ignored by ssh_shell_trusted.
GENEAGENT_HPC_DEFAULT_PARTITION=x86-shared
GENEAGENT_HPC_TOOL_PATHS={"plink":"/path/to/plink","plink2":"/path/to/plink2","bcftools":"/path/to/bcftools","gcta":"/path/to/gcta64"}
GENEAGENT_HPC_SSH_BINARY=ssh
# SSH auth modes:
# - batch: passwordless SSH key/agent auth.
# - control_master: run `geneagent remote-session-open`, type your server password once,
#   then GeneAgent reuses the local OpenSSH control socket without storing the password.
#   Run `geneagent remote-session-doctor` first to check local readiness.
#   For first validation, `geneagent remote-session-smoke --open-session` can open/check
#   the session and run the fixed harmless smoke command.
# - password_env: fallback for Windows OpenSSH ControlMaster failures. Run
#   `geneagent remote-password-set`; it writes GENEAGENT_HPC_SSH_PASSWORD only to
#   your local ignored `.env`. Never commit that value.
GENEAGENT_HPC_SSH_AUTH_MODE=batch
GENEAGENT_HPC_SSH_CONTROL_PATH=.geneagent/ssh_control/default.sock
# If the project `.geneagent` directory is not writable on Windows, set this to
# an absolute user-writable path such as C:/Users/<you>/AppData/Local/Temp/geneagent_ssh/default.sock.
GENEAGENT_HPC_SSH_CONTROL_PERSIST=4h
# For password_env mode only, add this to local `.env` via `geneagent remote-password-set`:
# GENEAGENT_HPC_SSH_PASSWORD=<server-password>
GENEAGENT_HPC_STRICT_HOST_KEY_CHECKING=accept-new
GENEAGENT_HPC_CONNECT_TIMEOUT_SECONDS=15
GENEAGENT_LOCAL_STATE_ROOT=.geneagent
GENEAGENT_REMOTE_AUTO_CONTINUE_ENABLED=true
GENEAGENT_REMOTE_AUTO_REPAIR_LEVEL=trusted
